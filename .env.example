# Required — at least one LLM provider (tried in this order, first key wins)
NVIDIA_API_KEY=nvapi-...
GROQ_API_KEY=gsk_...

# Optional — better scraping + screenshots (free tier at firecrawl.dev)
FIRECRAWL_API_KEY=fc-...

# Optional — enables the vision-based visual audit pass (only used if FIRECRAWL_API_KEY
# is also set, so a screenshot exists to analyze)
ANTHROPIC_API_KEY=sk-ant-...
